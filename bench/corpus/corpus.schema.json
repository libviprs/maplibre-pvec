{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "maplibre-pvec benchmark corpus",
  "type": "object",
  "additionalProperties": false,
  "required": ["revision", "manifestSha256", "cases"],
  "properties": {
    "revision": { "type": "string", "minLength": 1 },
    "manifestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fixtureId", "class", "evidenceClass", "entities", "curves", "pvec", "viewport"],
        "properties": {
          "fixtureId": { "type": "string", "minLength": 1 },
          "class": { "enum": ["known-truth", "architectural", "mep", "industrial", "huge", "spline-heavy", "adversarial"] },
          "evidenceClass": { "enum": ["KNOWN_TRUTH_EXACT", "DUAL_ORACLE_EQUIVALENT", "REAL_WORLD_DIFFERENTIAL"] },
          "entities": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
          "curves": {
            "type": "object",
            "additionalProperties": false,
            "required": ["total", "byClass"],
            "properties": {
              "total": { "type": "integer", "minimum": 0 },
              "byClass": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } }
            }
          },
          "pvec": {
            "description": "The prebuilt .pvec from pvec's generator. PRESENT with its size and digest, NOT_EMITTED with pvec's reason, PENDING only when no index was loaded.",
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "bytes", "sha256", "note"],
            "properties": {
              "status": { "enum": ["PENDING", "PRESENT", "NOT_EMITTED"] },
              "bytes": { "type": ["integer", "null"], "minimum": 1 },
              "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
              "note": { "type": "string" }
            }
          },
          "viewport": {
            "type": "object",
            "additionalProperties": false,
            "required": ["start", "zoomLadder", "panPath", "bearingSteps", "pitchSteps"],
            "properties": {
              "start": {
                "type": "object",
                "additionalProperties": false,
                "required": ["center", "zoom", "bearing", "pitch"],
                "properties": {
                  "center": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
                  "zoom": { "type": "number", "maximum": 22 },
                  "bearing": { "type": "number" },
                  "pitch": { "type": "number", "minimum": 0, "maximum": 85 }
                }
              },
              "zoomLadder": { "type": "array", "minItems": 1, "items": { "type": "number", "maximum": 22 } },
              "panPath": { "type": "array", "minItems": 1, "items": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 } },
              "bearingSteps": { "type": "array", "minItems": 1, "items": { "type": "number" } },
              "pitchSteps": { "type": "array", "minItems": 1, "items": { "type": "number", "minimum": 0, "maximum": 85 } }
            }
          }
        }
      }
    },
    "rasterCases": {
      "description": "Rasters over the 1e5 architectural strokes (#108): one A0 scan at 400 dpi and ten of them. The digest is the one pinned by bench/hw/raster-tiles.json.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "scans", "strokes", "scan"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "scans": { "enum": [1, 10] },
          "strokes": { "type": "string" },
          "scan": {
            "type": "object",
            "additionalProperties": false,
            "required": ["width", "height", "dpi", "edge", "tilesSha256"],
            "properties": {
              "width": { "type": "integer", "minimum": 1 },
              "height": { "type": "integer", "minimum": 1 },
              "dpi": { "const": 400 },
              "edge": { "enum": [256, 512, 1024] },
              "tilesSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        }
      }
    }
  }
}
