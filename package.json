{
  "name": "maplibre-pvec",
  "version": "0.0.0",
  "private": true,
  "description": "MapLibre GL JS add-on that streams .pvec directly",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "bash tools/run-jobs.sh",
    "build": "tsc -p tsconfig.build.json",
    "test:jobs": "node tools/check-jobs.mjs job-reports",
    "bench": "node bench/run.mjs"
  },
  "peerDependencies": {
    "maplibre-gl": ">=4.7.1"
  },
  "devDependencies": {
    "@playwright/test": "1.48.2",
    "@types/node": "22.9.0",
    "ajv": "8.17.1",
    "esbuild": "0.24.0",
    "maplibre-gl": "4.7.1",
    "typescript": "5.6.3",
    "vitest": "2.1.4"
  }
}
